@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border-col;
    border-radius: 14px;
    width: 600px;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;
    margin: 0px 0px 14px 0px;
    padding: 8px;
    background-color: @bg-alt;
    border-radius: 8px;
}

prompt {
    background-color: @accent;
    padding: 6px 12px;
    text-color: @bg;
    border-radius: 6px;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg;
    vertical-align: 0.5;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    spacing: 6px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
}

element selected {
    background-color: @bg-alt;
    text-color: @fg;
    border: 1px;
    border-color: @accent;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
